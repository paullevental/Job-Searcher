# Keep build contexts small and keep secrets out of image layers (AGENTS.md §9).
# A later `RUN rm .env` does NOT remove it from an earlier layer, so it must
# never enter the context in the first place.
.env
.env.*
!.env.example
*.pem
*.key
secrets/

.git/
.github/
docs/
*.md
!README.md

__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

.gradle/
build/

node_modules/
web/dist/

.idea/
.vscode/
.DS_Store
pgdata/
