# OfferRadar environment template.
#
# Copy to `.env` and fill in real values:  make env
# `.env` is gitignored and must never be committed (AGENTS.md §2 rule 7, §9).
#
# Every variable the code actually reads must appear here, uncommented.
# `make check-env` enforces that and fails if code reads an undocumented variable.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
ENV=dev
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Postgres
# Hostname is the Compose service name, so it resolves inside the network but
# not from your laptop. From the host, use localhost and the published port.
# ---------------------------------------------------------------------------
POSTGRES_USER=offerradar
POSTGRES_PASSWORD=replace-me-for-local-dev
POSTGRES_DB=offerradar
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# agents (Python, SQLAlchemy async) wants a driver-qualified URL
DATABASE_URL=postgresql+asyncpg://offerradar:replace-me-for-local-dev@postgres:5432/offerradar

# workflow (Java, JDBC) wants the JDBC form plus separate credentials
JDBC_DATABASE_URL=jdbc:postgresql://postgres:5432/offerradar
JDBC_DATABASE_USER=offerradar
JDBC_DATABASE_PASSWORD=replace-me-for-local-dev

# ---------------------------------------------------------------------------
# Redis
# agents reads the URL form; Spring Boot wants host/port separately.
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Service ports
# ---------------------------------------------------------------------------
AGENTS_HOST=0.0.0.0
AGENTS_PORT=8000
WORKFLOW_PORT=8080
WEB_PORT=5173

# web talks only to workflow (AGENTS.md §6). Browser-visible, so it must never
# hold a credential: anything prefixed VITE_ is compiled into the bundle.
VITE_WORKFLOW_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# Scout (M2)
# Rate limits and the User-Agent are per AGENTS.md rule 3. Retry caps mirror
# §8: exponential backoff with jitter, max 4 retries.
# ---------------------------------------------------------------------------
SCOUT_USER_AGENT="OfferRadar/0.1 (personal co-op job-search tool; contact: you@example.com)"
SCOUT_HTTP_TIMEOUT_SECONDS=20.0
SCOUT_MAX_RETRIES=4
SCOUT_RETRY_BASE_SECONDS=1.0
SCOUT_RETRY_MAX_SECONDS=30.0
SCOUT_RATE_LIMIT_RPS=1.0
SCOUT_RATE_LIMIT_BURST=5
SCOUT_ROBOTS_CACHE_TTL_SECONDS=3600
SCOUT_SIMPLIFY_REPOS=SimplifyJobs/Summer2027-Internships,SimplifyJobs/New-Grad-Positions
SCOUT_OUCKAH_REPOS=

# Optional. Unauthenticated GitHub allows 60 requests/hour, a token 5000.
# Needs no scopes: every repo Scout reads is public.
GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# Retrieval (M4)
# EmbeddingProvider per AGENTS.md §5/§8; nomic-embed-text is 768 dims (§7).
# Ollama runs natively on the host (Metal GPU), not in Compose; containers
# reach it via host.docker.internal, host-side make targets via localhost.
# ---------------------------------------------------------------------------
EMBEDDING_PROVIDER=ollama
OLLAMA_URL=http://host.docker.internal:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=60.0
OLLAMA_PORT=11434

# ---------------------------------------------------------------------------
# Matcher stage 2 (M5)
# ONLY the agents service may read model keys (AGENTS.md §9). Never commit one.
# LLM_PROVIDER=ollama needs OLLAMA_LLM_MODEL: a local model that supports tools.
# Prices are USD per million tokens for LLM_SCORE_MODEL (Haiku 5.5 defaults).
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-REPLACE-ME
LLM_PROVIDER=anthropic
LLM_SCORE_MODEL=claude-haiku-5-5
OLLAMA_LLM_MODEL=
SCORE_PROMPT_VERSION=score_v1
RUN_BUDGET_USD=0.50
MAX_LLM_CALLS_PER_RUN=100
LLM_MAX_TOKENS_SCORE=400
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_SECONDS=1.0
LLM_RETRY_MAX_SECONDS=30.0
LLM_PRICE_INPUT_PER_MTOK=0.10
LLM_PRICE_OUTPUT_PER_MTOK=0.50
LLM_PRICE_CACHE_READ_PER_MTOK=0.01
LLM_PRICE_CACHE_WRITE_PER_MTOK=0.125
GATE1_SHORTLIST_SIZE=20
AUTO_FORWARD_TOP_N=0
PREFILTER_TERMS=
PREFILTER_LOCATIONS=

# ---------------------------------------------------------------------------
# Not read by any code yet. Listed so the catalogue is complete and so the
# shape is agreed before the milestone that needs it. Uncomment when the
# milestone lands, and keep `make check-env` green.
# ---------------------------------------------------------------------------

# --- Not yet read: Recon / Scribe token caps (M10) ---
# LLM_MAX_TOKENS_DRAFT=400
# LLM_MAX_TOKENS_RECON=800

# --- Dedup thresholds (M3; re-derive for cosine in M4, see docs/TODO.md) ---
DEDUP_MERGE_THRESHOLD=0.92
DEDUP_REVIEW_THRESHOLD=0.84
DEDUP_MISSED_POLL_LIMIT=2
DEDUP_STALE_AFTER_DAYS=21
